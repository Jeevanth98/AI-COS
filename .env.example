# AI-COS Environment Configuration Example
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite path relative to project root)
DATABASE_URL=sqlite:///database/aicos.db

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# OCR (optional — set to 1 if Tesseract is installed)
OCR_ENABLED=0
TESSERACT_PATH=

# FastAPI (if running as separate service)
API_HOST=127.0.0.1
API_PORT=8000
